# VaultPilot — Bungie API credentials
# Copy this file to `.env` and fill in the values from your registered app
# at https://www.bungie.net/developer  (.env is gitignored — never commit it)

# --- From your Bungie app page (after "Create New App") ---
# "API Key" shown on the app page
BUNGIE_API_KEY=

# OAuth client id (Confidential client)
BUNGIE_CLIENT_ID=

# OAuth client secret (Confidential client) — KEEP SECRET
BUNGIE_CLIENT_SECRET=

# --- Must match the Redirect URL you entered on the Bungie app page EXACTLY ---
BUNGIE_REDIRECT_URI=https://localhost:7777/callback

# --- OAuth scopes (DOCUMENTATION ONLY) ---
# NOTE: Bungie does NOT accept a dynamic `scope` parameter in the authorize URL.
# The granted scope is fixed by the checkboxes on your Bungie app page. This var
# just records which scopes the app must have enabled. VaultPilot is read + act, so
# tick BOTH "Read your Destiny 2 information" and "Move or equip Destiny gear".
BUNGIE_OAUTH_SCOPE=ReadDestinyInventoryAndVault,MoveEquipDestinyItems

# --- Local callback server (must agree with BUNGIE_REDIRECT_URI above) ---
OAUTH_CALLBACK_HOST=localhost
OAUTH_CALLBACK_PORT=7777

# --- Where the OAuth token (access + refresh) is cached locally ---
TOKEN_STORE_PATH=.tokens.json
